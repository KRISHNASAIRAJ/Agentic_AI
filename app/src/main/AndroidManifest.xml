<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE to the cluster -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Map tiles, route search and turn-by-turn routing for the embedded map.
         Introduced for on-device OpenStreetMap navigation (see docs/MAPS.md).
         This is network access with a closed destination list, not a cloud
         account: tile.openstreetmap.org for tiles, router.project-osrm.org for
         keyless demo routing, api.graphhopper.com / api.mapbox.com only when
         the rider enters their own key (BYOK), nominatim.openstreetmap.org for
         place search. There is still no TVS account, no TVS server contact,
         and no telemetry upload anywhere in the app — grep the tree for
         HttpURLConnection if you do not believe the comment. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Read navigation from any maps app -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Permissions mirrored from the working Jupiter companion app
      (com.tvs.jupiter, CC BY-NC 4.0 — see research/SOURCES.md), each with the
      reason it is wanted here.
    -->
    <!-- Doze parks the GATT connection within minutes and the cluster drops the
         link when the presence packet stops. Without this exemption a ride dies
         the moment the screen goes off, which is most of a ride. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reconnect after a reboot or power cut. The cluster keeps advertising;
         nothing re-attaches without this. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Caller ID comes from the *notifications* of the phone/messaging apps
         via the notification listener above. We deliberately do NOT declare
         READ_PHONE_STATE, READ_CALL_LOG or READ_CONTACTS: no code path reads
         those stores, and they are the largest Play Protect risk signal. The
         cluster still shows the name/number carried in the notification; only
         contact-name resolution is lost, which is cosmetic. -->

    <!-- Parked location, only when the user asks for it -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Log export to Downloads on Android 9 and below. Not needed on 10+. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- No TVS contact, enforced by architecture rather than by audit.
         The app holds INTERNET solely for map tiles and routing (see the
         permission comment above and docs/MAPS.md). It never talks to TVS:
         no account, no registration, no SmartXonnect backend calls, and no
         telemetry upload. The network call sites are confined to
         dev.tvsopen.nav.maps; anything opening a connection from anywhere
         else is a bug. Contact and call-log data stay on the device — they
         are read only to render caller ID as bytes on the cluster. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Jupiter Drive"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVSRide">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transport.RideService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Re-attach after reboot. Gated on the user having left the app in a
             riding state; see BootReceiver. -->
        <receiver
            android:name=".transport.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The whole point: read turn-by-turn from Google Maps or any other
             maps app without an account anywhere. -->
        <service
            android:name=".nav.MapsNotificationListener"
            android:exported="true"
            android:label="Jupiter Drive navigation"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
